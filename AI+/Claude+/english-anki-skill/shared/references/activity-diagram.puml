@startuml add-english-word-to-anki
title Add English word to Anki — activity diagram
legend right
  |= color |= meaning |
  |<#LightBlue>| deterministic script call (shared/scripts/*.py) |
  |<#LightYellow>| Anki MCP call (skipped in --dry-run) |
  |<#LightGreen>| picture-picker subagent (photo search + visual check) |
  |<#Plum>| Google Cloud TTS (generate_tts.py) |
endlegend

start
:Parse arguments: input file path (default new_anki_words.md),\noptional --dry-run / --no-pictures flags;
:parse_input.py <file>; <<#LightBlue>>
if (exit code != 0?) then (yes)
  :Show reported line errors to user;
  stop
endif
:Read {source, line, word, sentence} entries\n(source = section's # header, null for # NO_SOURCE;\nunmarked lines silently skipped);
:list_source_tags.py — once per run, cached\n(live getTags, source:: prefix); <<#LightBlue>>

while (more entries?) is (yes)
  partition "2.1 Prepare" {
    :Determine POS of the word as used in its sentence;
    :Pick most specific POS tag(s)\nfrom shared/assets/en-pos-anki-tags.md;
    :Pick source tag from cached list\n(loose match ignoring a trailing year;\nnone if source is null);
    :Determine base form + a/an/to prefix\nfor the English field;
    if (multi-word entry?) then (yes)
      :Pick unit tag (idiom / phrase / collocation);
    endif
  }

  :find_duplicate.py "<base form>" "<POS tag>"\n(direct mode: findNotes + notesInfo inside,\na/an/to + en::parts::* matching); <<#LightBlue>>

  if (duplicates > 1?) then (yes)
    :Record row: "Ambiguous match (N candidates) — skipped"\n(sentence stays in the input file);
  else (0 or 1)
    if (exactly 1 duplicate?) then (yes — 2.2 duplicate path)
      :Step E: add missing a/an/to to English\n(mark English audio stale if non-empty);
      :build_example_html.py\n(existing Example-real-life, surface word, sentence, source); <<#LightBlue>>
      :Keep html only if changed\n(already_present -> leave field untouched);
      :Reuse find_duplicate.py's note.status\nas the B1 worklist (no extra note_status.py);
    else (no — 2.3 new note path)
      :English = base form with prefix;
      :build_example_html.py (existing: null)\nfor Example-real-life; <<#LightBlue>>
      :note_status.py on the empty note\n(B1: every Claude field is empty); <<#LightBlue>>
    endif

    partition "Backfill routine (backfill-routine.md)" {
      :B0: slugify.py <English> <pos> --all-media\n(photo/icon/mp3 filenames); <<#LightBlue>>
      :B2: generate empty text fields per field-plan.md\n(Transcription, Definition, Russian, Synonym1/Synonyms,\nAntonym1/Antonyms; Examples1 via build_example_html.py);
      if (Picture empty and not --no-pictures?) then (yes)
        fork
          :Spawn picture-picker in background\nonce Definition is known\n(search_images.py + thumbnails + Read check,\nreturns {path} or {path: null}); <<#LightGreen>>
        fork again
          :search_icons.py <bare headword>\n(retry once with a synonym if []); <<#LightBlue>>
          if (icon found?) then (yes)
            :search_icons.py --fetch <id> <tmp.svg>; <<#LightBlue>>
          endif
        end fork
        :Picture = photo <img> and/or icon <img>;
      endif
      :B3: generate_tts.py --batch for all needed audio\n(audio_to_generate + paired audio of fields\nfilled in B2 or normalized in E); <<#Plum>>
      :storeMediaFile for photo, icon and mp3s\nunder their slugs; delete temp files; <<#LightYellow>>
      :B4: ~api::absent::* tags for empty Synonym1/Synonyms/\nAntonym1/Antonyms, and Picture if neither image found\n(no picture tag under --no-pictures);
    }

    if (duplicate path?) then (yes)
      :Single updateNoteFields with every changed field\n(English, Example-real-life, backfilled fields); <<#LightYellow>>
      if (note changed?) then (yes)
        :addTags en::to-learn (+ absence tags); <<#LightYellow>>
      endif
      :Record row: "Duplicate — appended new sentence;\nbackfilled …" / "Duplicate — nothing to update";
    else (new note)
      :addNote to deck En::English, note type En-word-or-sentence\n(tags: POS, source, unit, absence, en::to-learn); <<#LightYellow>>
      :Record row: "Created new note" (NID, or "(new)" in dry-run);
    endif
  endif
endwhile (no)

:Print report table (one row per entry, input order);
:Print summary line\n("N new notes, M duplicates updated, K skipped;\ncleared / would clear X imported sentence(s)");
if (live mode?) then (yes)
  :parse_input.py --clear <file>\nwith {"remove_lines": [...]} on stdin\n(all but ambiguous skips; every header kept); <<#LightBlue>>
else (--dry-run)
  :Leave the input file untouched\n(only count lines that would be cleared);
endif
stop

note right
  --dry-run: every Anki mutation (addNote, updateNoteFields,
  addTags, storeMediaFile) and the input-file clearing are skipped
  and reported instead; find_duplicate.py and the picture lookups
  still run.
  --no-pictures: the whole Picture flow (picker + icon) is skipped,
  even in dry-run; note_status.py gets --no-pictures.
end note
@enduml
