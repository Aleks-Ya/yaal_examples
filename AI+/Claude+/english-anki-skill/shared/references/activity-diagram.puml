@startuml add-english-word-to-anki
title Add English word to Anki — activity diagram
legend right
  |= color |= meaning |
  |<#LightBlue>| deterministic script call (scripts/*.py) |
  |<#LightYellow>| Anki MCP call |
  |<#LightGreen>| image search + Read-tool visual check |
endlegend

start
:Parse arguments: input file path,\noptional --dry-run / --no-pictures flags;
:Run scripts/parse_input.py on the file; <<#LightBlue>>
if (exit code != 0?) then (yes)
  :Show reported line errors to user;
  stop
endif
:Read {source, line, word, sentence} entries\nfrom parse_input.py output\n(source = each section's # header, null for # NO_SOURCE);

while (more word/sentence pairs?) is (yes)
  :Determine POS of the word as used in its sentence;
  :Pick POS tag from assets/en-pos-anki-tags.md;
  :Pick source tag from assets/word-sources-anki-tags.md\n(loose match, ignoring a trailing year);
  :Determine base form + a/an/to prefix\nfor the English field;
  if (multi-word entry?) then (yes)
    :Pick unit tag (idiom / phrase / collocation);
  endif

  :findNotes + notesInfo\n(broad wildcard search on the word); <<#LightYellow>>
  :Run scripts/find_duplicate.py\n(word, POS tag, candidates); <<#LightBlue>>

  if (duplicate count > 1?) then (yes)
    :Record report-table row\n(Outcome: ambiguous match, skipped);
  elseif (duplicate count == 1?) then (yes)
    :Run scripts/build_example_html.py\n(existing field, word, sentence, source); <<#LightBlue>>
    if (changed?) then (yes)
      :updateNoteFields: Example-real-life; <<#LightYellow>>
    else (no)
      :Leave field untouched\n(sentence already present);
    endif
    :Run scripts/note_status.py\n(which fields empty vs. absence-tagged); <<#LightBlue>>
    :Backfill empty Claude-owned fields\nper references/backfill-routine.md;
    if (Picture empty and not tagged absent?) then (yes)
      :Run scripts/search_images.py\n(depictable query, ranked candidates); <<#LightBlue>>
      :For top candidates: fetch_and_resize_image.py + view\nwith Read tool, pick best clear fit; <<#LightGreen>>
      if (suitable image found?) then (yes)
        :storeMediaFile: store chosen resized image\n(filename from slugify.py); <<#LightYellow>>
        :Delete temp files;
      endif
    endif
    if (backfilled field still empty?) then (yes)
      :Add matching ~api::absent::* tag;
    endif
    :updateNoteFields: backfilled fields (if any); <<#LightYellow>>
    :Record report-table row\n(NID, Word, Base form, POS, Outcome);
  else (no duplicates)
    :Generate all field values\nper references/field-plan.md;
    :Run scripts/build_example_html.py\n(existing: null) for Example-real-life; <<#LightBlue>>
    :Run scripts/search_images.py\n(depictable query, ranked candidates); <<#LightBlue>>
    :For top candidates: fetch_and_resize_image.py + view\nwith Read tool, pick best clear fit; <<#LightGreen>>
    if (suitable image found?) then (yes)
      :storeMediaFile: store chosen resized image\n(filename from slugify.py); <<#LightYellow>>
      :Delete temp files;
      :Set Picture field to <img src="filename">;
    else (no)
      :Leave Picture empty;
    endif
    :Add ~api::absent::* tags for any empty\nSynonym1/Synonyms/Antonym1/Antonyms/Picture;
    :addNote to deck En::English; <<#LightYellow>>
    note right: updateNoteFields / addNote calls, and the storeMediaFile store step,\nare skipped (report-only) in --dry-run mode; the image search, candidate\ndownload, and Read-tool visual check still run.\nIn --no-pictures mode the whole Picture flow (search, download, visual\ncheck, store) is skipped even under --dry-run; Picture stays empty with no\n~api::absent::picture tag and does not block completion\n(note_status.py is called with --no-pictures)
    :Record report-table row\n(NID, Word, Base form, POS, Outcome);
  endif
endwhile (no)

:Print report table (one row per word);
:Print summary line\n(N new notes, M duplicates updated, K skipped);
:Remove cleanly-imported sentence lines from the input file\nvia parse_input.py --clear (remove_lines); all headers kept,\neven emptied ones; skipped sentences stay; <<#LightBlue>>
note right: Live mode only. Skipped in --dry-run (file left untouched;\nthe report just counts sentences that would be cleared).
stop
@enduml
